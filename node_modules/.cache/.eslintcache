,"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\redux\\reducers\\suggestionsReducer.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\redux\\reducers\\discoverReducer.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\redux\\reducers\\socketReducer.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\redux\\reducers\\detailPostReducer.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\redux\\reducers\\messageReducer.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\redux\\reducers\\notifyReducer.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\components\\adminDashboard\\sidebar\\Sidebar.js",["389","390","391","392","393","394"],"import { Link } from 'react-router-dom'\r\nimport { useDispatch } from \"react-redux\";\r\nimport { logout } from \"../../../redux/actions/authAction\";\r\nimport \"./Sidebar.css\";\r\nimport React, { useState } from \"react\";\r\nimport Main from \"../main/Main\";\r\nimport AdminManagement from \"../adminManagement/AdminManagement\";\r\nimport Spam from \"../spamManagement/Spam\";\r\nimport UsersManagement from \"../usersManagement/UsersManagement\";\r\n\r\n\r\nconst Sidebar = () => {\r\n  const dispatch = useDispatch();\r\n    const [adminMenu, setAdminMenu] = useState(1);\r\n\r\n\r\n  return (\r\n    <>\r\n      {adminMenu === 1 && <Main />}\r\n      {adminMenu === 2 && <AdminManagement />}\r\n      {adminMenu === 3 && <Spam />}\r\n      {adminMenu === 4 && <UsersManagement />}\r\n\r\n      <div className=\"sidebar_responsive\" id=\"sidebar\">\r\n        <div className=\"sidebar__title\">\r\n          <div className=\"sidebar__img\">\r\n            <h1>Socialgram</h1>\r\n          </div>\r\n          <i className=\"fa fa-times\" id=\"sidebarIcon\" aria-hidden=\"true\"></i>\r\n        </div>\r\n\r\n        <div className=\"sidebar__menu\">\r\n          <div\r\n            className={`sidebar__link ${adminMenu === 1 && \"active_menu_link\"}`}\r\n            onClick={() => setAdminMenu(1)}\r\n          >\r\n            <i className=\"fa fa-th\"></i>\r\n            <a href=\"#\">Dashboard</a>\r\n          </div>\r\n          <h2>ADMIN CONTROL</h2>\r\n          <div\r\n            className={`sidebar__link ${adminMenu === 2 && \"active_menu_link\"}`}\r\n            onClick={() => setAdminMenu(2)}\r\n          >\r\n            <i className=\"fa fa-lock\" aria-hidden=\"true\"></i>\r\n            <a href=\"#\">Admin Management</a>\r\n          </div>\r\n          <div\r\n            className={`sidebar__link ${adminMenu === 3 && \"active_menu_link\"}`}\r\n            onClick={() => setAdminMenu(3)}\r\n          >\r\n            <i className=\"fa fa-ban\"></i>\r\n            <a href=\"#\">Spams Management</a>\r\n          </div>\r\n          <div\r\n            className={`sidebar__link ${adminMenu === 4 && \"active_menu_link\"}`}\r\n            onClick={() => setAdminMenu(4)}\r\n          >\r\n            <i className=\"fa fa-wrench\"></i>\r\n            <a href=\"#\">Users Management</a>\r\n          </div>\r\n          <div className=\"sidebar__link\">\r\n            <i className=\"fa fa-archive\"></i>\r\n            <a href=\"#\">xyz</a>\r\n          </div>\r\n          <div className=\"sidebar__link\">\r\n            <i className=\"fa fa-handshake-o\"></i>\r\n            <a href=\"#\">xyz</a>\r\n          </div>\r\n\r\n          <div className=\"sidebar__logout\">\r\n            <i className=\"fa fa-power-off\"></i>\r\n            <Link to=\"/\" onClick={() => dispatch(logout())}>\r\n              Log out\r\n            </Link>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </>\r\n  );\r\n};\r\n\r\nexport default Sidebar;\r\n","C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\components\\LoadMoreBtn.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\components\\PostThumb.js",["395","396"],"import React from 'react';\r\nimport { Link } from \"react-router-dom\";\r\nimport { useSelector } from \"react-redux\";\r\nimport { imageShow, videoShow } from \"../utils/mediaShow\";\r\n\r\nconst PostThumb = ({ posts, result }) => {\r\n  const { theme } = useSelector((state) => state);\r\n\r\n  if (result === 0 ){\r\n    return <h2 className=\"text-center color-c1\">No Post</h2>\r\n  }\r\n\r\n    const imageShow = (src) => {\r\n      return (\r\n        <img\r\n          src={src}\r\n          alt={src}\r\n          style={{ filter: theme ? \"invert(1)\" : \"invert(0)\" }}\r\n        />\r\n      );\r\n    };\r\n\r\n    const videoShow = (src) => {\r\n      return (\r\n        <video\r\n          controls\r\n          src={src}\r\n          alt={src}\r\n          style={{ filter: theme ? \"invert(1)\" : \"invert(0)\" }}\r\n        />\r\n      );\r\n    };\r\n    return (\r\n      <div className=\"post_thumb\">\r\n        {posts && posts?.map((post) => (\r\n          <Link to={`/post/${post._id}`} key={post._id}>\r\n            <div className=\"post_thumb_display\">\r\n              {post?.images[0]?.url?.match(/video/i)\r\n                ? videoShow(post?.images[0]?.url, theme)\r\n                : imageShow(post?.images[0]?.url, theme)\r\n              }\r\n\r\n\r\n              <div className=\"post_thumb_menu\">\r\n                <i className=\"far fa-thumbs-up\">{post.likes.length}</i>\r\n                <i className=\"far fa-comments\">{post.comments.length}</i>\r\n              </div>\r\n            </div>\r\n          </Link>\r\n        ))}\r\n      </div>\r\n    );\r\n};\r\n\r\nexport default PostThumb\r\n","C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\redux\\actions\\discoverAction.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\components\\PostCard.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\redux\\actions\\profileAction.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\components\\message\\LeftSide.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\components\\message\\RightSide.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\components\\profile\\Saved.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\components\\profile\\Posts.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\components\\profile\\Info.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\components\\Avatar.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\components\\NotifyModal.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\components\\UserCard.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\components\\FollowBtn.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\utils\\upoader.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\components\\adminDashboard\\main\\Main.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\components\\adminDashboard\\spamManagement\\Spam.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\components\\adminDashboard\\adminManagement\\AdminManagement.js",[],"C:\\Users\\Chandresh Prajapati\\OneDrive\\Desktop\\Social-Gram\\social-gram-client\\src\\components\\adminDashboard\\usersM